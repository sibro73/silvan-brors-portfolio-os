# Kopieren nach frontend/.env.local (nicht committen).
# Basis-URL des Backends. Leer lassen = kein Backend, die Seite zeigt die Daten aus src/data/.
# Im Dev-Modus ist ohne Angabe http://localhost:8080 gesetzt (Spring-Backend, docker compose).
# `/` = gleiche Domain (Pages Functions, so baut der Deploy die Live-Seite).
VITE_API_URL=http://localhost:8080
# IPA-Chat mit echten Fragen an ipa-assistant, nur lokal (siehe docs/api.md).
VITE_IPA_LIVE=false
# IPA-Chat über die Pages Function (RAG auf Cloudflare, so baut der Deploy die Live-Seite).
# Braucht die Function, läuft also nur mit `wrangler pages dev`, nicht mit `npm run dev`.
VITE_IPA_AGENT=false
# Ziel für IPA-Fragen: `/` = gleiche Domain (Pages Function). Leer = VITE_API_URL.
VITE_IPA_URL=
