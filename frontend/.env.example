# Kopieren nach frontend/.env.local (nicht committen).
# Basis-URL des Backends. Leer lassen = kein Backend, die Seite zeigt die Daten aus src/data/.
# Im Dev-Modus ist ohne Angabe http://localhost:8080 gesetzt.
VITE_API_URL=http://localhost:8080
# IPA-Chat mit echten Fragen, nur lokal (ipa-assistant muss laufen, siehe docs/api.md).
# Auf der Live-Seite nicht setzen: dort zeigt der Chat Beispielantworten.
VITE_IPA_LIVE=false
