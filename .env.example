# Kopieren nach .env und ausfüllen. .env nie committen.
STEAM_API_KEY=
STEAM_APP_ID=
# Keys für die Schreib-Endpunkte (Header X-Api-Key). Leer = Endpunkt geschlossen.
CLIPPER_API_KEY=
AGENTS_API_KEY=
LLM_API_KEY=
# IPA-Chat: Adresse des separaten Projekts ipa-assistant. Leer = Assistent offline.
# Lokal z. B. http://host.docker.internal:8081 (ipa-assistant mit --server.port=8081 starten)
IPA_ASSISTANT_URL=
# Nur nötig, wenn ipa-assistant hinter Cloudflare Access liegt (Service-Token)
IPA_ACCESS_CLIENT_ID=
IPA_ACCESS_CLIENT_SECRET=
# Lokal: compose-Datenbank. Produktion (Neon): jdbc:postgresql://<host>/<db>?sslmode=require
POSTGRES_URL=jdbc:postgresql://localhost:5433/portfolio
# Host-Port der Compose-Datenbank (5432 ist oft schon von einer lokalen Installation belegt)
POSTGRES_PORT=5433
POSTGRES_USER=portfolio
# Pflicht für docker compose
POSTGRES_PASSWORD=
# Erlaubte Frontend-Origins für CORS, kommagetrennt
FRONTEND_ORIGIN=http://localhost:5173
# Host-Port des Backends in docker compose
BACKEND_PORT=8080
