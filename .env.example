# Kopieren nach .env und ausfüllen. .env nie committen.
STEAM_API_KEY=
STEAM_APP_ID=
# Keys für die Schreib-Endpunkte (Header X-Api-Key). Leer = Endpunkt geschlossen.
CLIPPER_API_KEY=
AGENTS_API_KEY=
LLM_API_KEY=
POSTGRES_URL=jdbc:postgresql://localhost:5433/portfolio
# Host-Port der Compose-Datenbank (5432 ist oft schon von einer lokalen Installation belegt)
POSTGRES_PORT=5433
POSTGRES_USER=portfolio
# Pflicht für docker compose
POSTGRES_PASSWORD=
# Erlaubte Frontend-Origins für CORS, kommagetrennt
FRONTEND_ORIGIN=http://localhost:5173
# Host-Port des Backends in docker compose
BACKEND_PORT=8080
